APP_NAME=Torrino
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── DATABASE ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=torrino
DB_USERNAME=root
DB_PASSWORD=

# ── SESSION / CACHE / QUEUE ──────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── REDIS (optional — use for production performance) ────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── MAIL (for OTP verification emails) ──────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@torrino.com
MAIL_FROM_NAME="${APP_NAME}"

# ── STRIPE PAYMENTS (REQUIRED) ──────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_KEY=pk_test_your_publishable_key
STRIPE_SECRET=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── MUX VIDEO HOSTING (REQUIRED for lesson videos) ──────
# Get from: https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_WEBHOOK_SECRET=your_mux_webhook_secret

# ── OPENAI (REQUIRED for AI Tutor) ─────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ── FIREBASE CLOUD MESSAGING (for push notifications) ──
FCM_SERVER_KEY=your_firebase_server_key

# ── LARAVEL REVERB (WebSocket for real-time chat) ──────
REVERB_APP_ID=torrino
REVERB_APP_KEY=your_reverb_app_key
REVERB_APP_SECRET=your_reverb_app_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# ── SANCTUM ──────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,yourdomain.com

VITE_APP_NAME="${APP_NAME}"
